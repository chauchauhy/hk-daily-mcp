# Copy to .env and fill in values. .env is gitignored and never committed.
# Only the keys below are read by the code (see src/utils/env_load_util.py).

# FastAPI server
APPLICATION_SERVER_HOST=127.0.0.1
APPLICATION_SERVER_PORT=8000

# Absolute path to this repo root (the folder containing res/).
# Optional: when unset, the repo root is derived from the source location.
BASE_FOLDER=/absolute/path/to/hk-daily-mcp

# KMB static fallback data (filenames inside res/, used when the KMB API is down)
KMB_ROUTE_DATA=route_data.json
KMB_STOP_DATA=stop_data.json

# Search radius in degrees for nearby-stop lookups
KMB_NEAR_STOP_DISTANCE=0.003

# HTTP client timeout in seconds
DEFAULT_HTTPX_TIMEOUT=60

