{
  "version": 1,
  "disable_existing_loggers": false,

  "formatters": {
    "standard": {
      "format": "%(asctime)s [%(process)d] [%(levelname)-8s] %(name)s - %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    },
    "access": {
      "format": "%(asctime)s [%(process)d] [ACCESS  ] %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    },
    "error": {
      "format": "%(asctime)s [%(process)d] [%(levelname)-8s] %(name)s %(pathname)s:%(lineno)d - %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    }
  },

  "filters": {
    "warning_and_above": {
      "()": "logging.Filter",
      "name": ""
    }
  },

  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "standard",
      "stream": "ext://sys.stdout",
      "level": "INFO"
    },

    "api_file": {
      "class": "logging.handlers.TimedRotatingFileHandler",
      "formatter": "standard",
      "filename": "${LOG_DIR}/api.log",
      "when": "midnight",
      "interval": 1,
      "backupCount": 30,
      "encoding": "utf-8",
      "utc": false,
      "level": "INFO"
    },

    "access_file": {
      "class": "logging.handlers.TimedRotatingFileHandler",
      "formatter": "access",
      "filename": "${LOG_DIR}/access.log",
      "when": "midnight",
      "interval": 1,
      "backupCount": 30,
      "encoding": "utf-8",
      "utc": false,
      "level": "INFO"
    },

    "discord_file": {
      "class": "logging.handlers.TimedRotatingFileHandler",
      "formatter": "standard",
      "filename": "${LOG_DIR}/discord_bot.log",
      "when": "midnight",
      "interval": 1,
      "backupCount": 30,
      "encoding": "utf-8",
      "utc": false,
      "level": "INFO"
    },

    "error_file": {
      "class": "logging.handlers.TimedRotatingFileHandler",
      "formatter": "error",
      "filename": "${LOG_DIR}/error.log",
      "when": "midnight",
      "interval": 1,
      "backupCount": 90,
      "encoding": "utf-8",
      "utc": false,
      "level": "ERROR"
    }
  },

  "loggers": {
    "uvicorn": {
      "handlers": ["console", "api_file", "error_file"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["console", "access_file"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["console", "api_file", "error_file"],
      "level": "INFO",
      "propagate": false
    },
    "fastapi": {
      "handlers": ["console", "api_file", "error_file"],
      "level": "INFO",
      "propagate": false
    },
    "httpx": {
      "handlers": ["console", "api_file"],
      "level": "WARNING",
      "propagate": false
    },
    "discord": {
      "handlers": ["console", "discord_file", "error_file"],
      "level": "INFO",
      "propagate": false
    },
    "discord.http": {
      "handlers": ["console", "discord_file"],
      "level": "WARNING",
      "propagate": false
    },
    "__main__": {
      "handlers": ["console", "discord_file", "error_file"],
      "level": "INFO",
      "propagate": false
    }
  },

  "root": {
    "handlers": ["console", "api_file", "error_file"],
    "level": "INFO"
  }
}
